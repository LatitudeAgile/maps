# Copy to .env.local (gitignored) and fill in. Never commit a real key.
# ArcGIS Location Platform API key with the basemap styles privilege.
# Leave blank to run on the fallback basemap (OpenStreetMap).
# The key works only from the referrer URLs set on it (README, "API key", step 5), ports
# included: e.g. http://localhost:5173 for npm run dev, http://localhost:4173 for npm run preview.
VITE_ARCGIS_API_KEY=
